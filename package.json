{
  "name": "marginalia",
  "version": "0.1.0",
  "description": "Marginalia - AI 智能文献阅读与研究辅助系统",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "backend:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-backend.ps1",
    "backend:test": "powershell -ExecutionPolicy Bypass -File scripts/test-backend.ps1",
    "dev:web": "vite --config vite.web.config.ts",
    "icon": "backend\\.venv\\Scripts\\python.exe scripts\\make-icon.py",
    "backend:build": "powershell -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "pack": "electron-vite build && electron-builder --win dir",
    "dist": "npm run backend:build && electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource/inter": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.64.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
